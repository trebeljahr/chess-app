# Host-side port override for docker-compose (optional)
# PORT=3514

# Redis URL for distributed pub/sub (multi-instance deployments)
# Leave unset for single-instance mode (uses in-process EventEmitter)
# REDIS_URL=redis://localhost:3515

# SQLite database file path
# CHESS_DB_FILE=/app/data/chess.db

# GlitchTip DSN for server error reports (Coolify env of chess-server).
# Unset: the server reports nothing and /trpc/_e answers 404.
# SENTRY_DSN=https://<key>@glitchtip.trebeljahr.com/<id>
# SENTRY_ENVIRONMENT=production

# Same DSN for the browser, inlined at build time (GitHub repository variable
# VITE_SENTRY_DSN in CI). Unset: the client ships no SDK and reports nothing.
# VITE_SENTRY_DSN=https://<key>@glitchtip.trebeljahr.com/<id>
