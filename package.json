{
  "name": "chess-app",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:redis": "docker-compose up redis",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "smoke:health": "node scripts/smoke-health.mjs",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "setup": "npm install",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky",
    "test:security": "tsx --test tests/auth-limit.test.ts",
    "backup:status": "hatchkit backup status --project chess-app",
    "backup:list": "hatchkit backup snapshots --project chess-app",
    "backup:restore": "hatchkit backup restore --project chess-app"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.500.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "body-parser": "^1.20.6",
      "path-to-regexp": "^0.1.13",
      "qs": "^6.16.0",
      "minimist": "^1.2.8"
    }
  }
}
